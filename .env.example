# ---------------------------------------------------------------------------
#  Booking app settings. Copy this file to ".env" and fill it in.
#  (Prices, closed days and page texts are edited in the dashboard, not here.)
# ---------------------------------------------------------------------------

# Public address of the booking app, without a trailing slash.
# Used in ticket emails and download links.
BASE_URL=https://book.bahiapalace.com

# Port the app listens on. Many hosts (cPanel, Hostinger) set this for you.
PORT=3000

# Leave as production on your server.
NODE_ENV=production

# Venue time zone, used for "today" and the same-day sales cut-off.
TIMEZONE=Africa/Casablanca

# --- Dashboard (https://YOUR-BOOKING-ADDRESS/admin) --------------------------
# Use a long password (at least 10 characters).
ADMIN_PASSWORD=change-me-to-a-long-password

# Where sale notifications and alerts (low stock, problems) are sent.
ADMIN_EMAIL=you@example.com

# --- PayPal ------------------------------------------------------------------
# Easiest: leave these empty and connect PayPal on the dashboard's PayPal page.
# It checks the keys, sets up the webhook and lets you switch between test and live.
# Keys connected there take priority over the ones below.
#
# Starting mode: sandbox = test payments with PayPal test accounts, live = real money.
# (mock = simulated payments for trying the app on your own computer only.)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Only for a webhook you created by hand (address: BASE_URL + /api/paypal/webhook).
PAYPAL_WEBHOOK_ID=

# --- Email (SMTP) --------------------------------------------------------------
# Gmail / Google Workspace: smtp.gmail.com, port 465, SMTP_SECURE=true,
#   SMTP_USER = your Gmail address, SMTP_PASS = an App Password (not your normal password).
# Hostinger email: smtp.hostinger.com, port 465, SMTP_SECURE=true.
# cPanel mailbox: mail.yourdomain.com, port 465, SMTP_SECURE=true.
# Leave SMTP_HOST empty to save emails as files in data/outbox instead (testing).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Some shared hosts use a certificate that doesn't match the mail server name.
# Only if sending fails with a certificate error, set this to false.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Sender shown to customers. With Gmail this must be your Gmail address (or a verified alias).
MAIL_FROM="Bahia Palace Tickets <tickets@bahiapalace.com>"
# Where customer replies go (optional).
MAIL_REPLY_TO=

# --- Storage -------------------------------------------------------------------
# Orders/settings and the ticket folders. Relative paths are inside the app folder.
# On hosts that replace the app folder on every deploy (e.g. Hostinger Node.js apps),
# use absolute paths OUTSIDE the app folder, e.g. /home/USER/booking-storage/data
DATA_DIR=./data
TICKETS_DIR=./tickets
# In sandbox mode tickets come from a separate test folder (default: TICKETS_DIR + "-sandbox"),
# so PayPal test accounts can never receive your real tickets.
SANDBOX_TICKETS_DIR=

# --- Embedding in your website ---------------------------------------------------
# Websites allowed to show the booking page inside an iframe (comma separated).
# Leave empty to allow any site.
EMBED_ALLOWED_ORIGINS=https://bahiapalace.com,https://www.bahiapalace.com

# Leave empty: the visitor's address is detected automatically (also on cPanel/Passenger,
# and on Render, which puts Cloudflare in front of every app).
# If you put Cloudflare in front of your own server, set TRUST_PROXY=cloudflare, but only
# if the server accepts web traffic from Cloudflare alone.
TRUST_PROXY=
